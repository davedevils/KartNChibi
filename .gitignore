# ================================================================
# KnC - Git Ignore
# ================================================================

# Build directories
build/
!scripts/build/
/release/
/Release/
/debug/
/Debug/

# Visual Studio
.vs/
*.suo
*.user
*.sln.docstates
*.vcxproj.user
*.vcxproj.filters

# Compiled outputs
*.exe
*.dll
*.lib
*.obj
*.pdb
*.ilk
*.exp

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Temp files
*.tmp
*.temp

# Debug output files (never commit these)
debug_*.txt

# Generated documentation (regenerate with: docs/engine/generate_docs.bat)
docs/engine/html/
docs/engine/index.html
dx11_*.txt
dx12_*.txt
vulkan_*.txt
shader_calls.txt

# Backup files
*_backup_*.zip
*_backup_*.7z

# Archives
*.zip
*.7z
*.rar
*.tar
*.gz

# Environment / secrets (never commit credentials)
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db
desktop.ini

# Node modules (web tools)
node_modules/
package-lock.json

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Dev Client (game files, reverse engineering)
DevClient/

# Exceptions - Keep these
!scripts/*.bat
!scripts/*.ps1
!thirdparty/**/*.lib
!thirdparty/**/*.dll
server/build-verify/
build-server/
build-clientpatch/
_devclient_attic/

/build-mitm/
# real account server and paths for the mitm tool copy the example files to start these
tools/mitm/mitm.local.ini
tools/mitm/mitm.local.bat
tools/mitm/relay.log
tools/mitm/mitm_packets.log

# every out of source tree, build/ is the solution, the rest are per project trees
build*/
build-*/
!scripts/build/
logs/
# tool state written next to the exe or in the cwd
dat_manager.ini
model_viewer.ini
ui_editor.ini
# session leftovers
.playwright-mcp/
roomid.txt
_devclient_attic/

# test runs write here, only golden/ is versioned
tests/output/*
!tests/output/golden/


# stock client reference captures of the user
/reference/

# website game art mirrored from chibikart dot gg run npm run mirror-assets to refill
website/public/favicon.png
website/public/images/logo.png
website/public/images/wallpaper.jpg
website/public/images/drivers/
website/public/images/levels/

# stock client parity screenshots regenerated by tools/stock_docker see docs/client/UI_PARITY.md
docs/client/parity/*_stock.png

# real secrets for the public history rewrite copy redact example txt to start
tools/release/redact.txt

# nuget restore output, fetch it with nuget restore, do not commit it
launcher/packages/

# release packages built by hand never commit one
dist/
