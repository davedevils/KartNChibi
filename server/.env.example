# Copy this file to .env and change the passwords before you run docker compose up

# Ports the outside world uses, change these if something else is already on them
LOGIN_PORT=50017
GAME_PORT=50018
WEB_PORT=8080

# Shown on the signup page
SITE_NAME=Kart N Chibi

# Database, only reachable inside the compose network, never published
DB_NAME=knc_emu
DB_USER=knc
DB_PASSWORD=knc_password
DB_ROOT_PASSWORD=knc_root_2025

# INFO is right for a live server, DEBUG logs every packet and gets loud fast
KNC_LOG_LEVEL=INFO

# Trims the two biggest catalogues in the login burst, 1 keeps them on
KNC_CARPART_CATALOG=1
KNC_PART_UICAT=1

# Login game and web admin secrets, copy this file to env and fill in real values, never commit a real secret

# Shared secret the game server presents to the login server on registration
KNC_INTERNAL_KEY=change_this_to_a_random_string

# Bearer token required to call the web admin api
ADMIN_TOKEN=change_this_to_a_random_string
