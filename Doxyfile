# Doxyfile for KnC Engine
# Generated for enterprise-grade API documentation
# Run: doxygen Doxyfile (from project root)

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = "KnC Engine"
PROJECT_NUMBER         = "1.0"
PROJECT_BRIEF          = "Multi-backend game engine for Kart N'Chibi"
PROJECT_LOGO           =
OUTPUT_DIRECTORY       = docs/engine
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
INPUT                  = engine \
                         docs/engine/INDEX.md \
                         docs/engine/RENDER_PIPELINE.md \
                         docs/engine/RHI_REFERENCE.md \
                         docs/engine/SHADER_SYSTEM.md \
                         docs/engine/UI_SYSTEM.md \
                         docs/engine/NIF_PIPELINE.md
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h *.cpp *.md
RECURSIVE              = YES
EXCLUDE                = engine/niflib \
                         engine/legacy \
                         engine/pch.h \
                         engine/pch.cpp
EXCLUDE_PATTERNS       = */thirdparty/* */niflib/include/* */niflib/src/*
USE_MDFILE_AS_MAINPAGE = docs/engine/INDEX.md

#---------------------------------------------------------------------------
# Build
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = NO

#---------------------------------------------------------------------------
# Parsing
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
SKIP_FUNCTION_MACROS   = YES
BUILTIN_STL_SUPPORT    = YES

#---------------------------------------------------------------------------
# Output formats
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = DARK
HTML_DYNAMIC_SECTIONS  = YES
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = YES
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO

GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

#---------------------------------------------------------------------------
# Diagrams
#---------------------------------------------------------------------------
HAVE_DOT               = NO
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

#---------------------------------------------------------------------------
# Source browsing
#---------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
VERBATIM_HEADERS       = YES

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO

#---------------------------------------------------------------------------
# Misc
#---------------------------------------------------------------------------
SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO
SORT_MEMBERS_CTORS_1ST = YES
SHOW_NAMESPACES        = YES
SHOW_FILES             = YES
SHOW_INCLUDE_FILES     = YES
TAB_SIZE               = 4
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
